# Environment variables override the local config; .env is not loaded automatically.
MINIIMA_HOME=
MINIIMA_API_KEY=
MINIIMA_BASE_URL=https://api.deepseek.com
MINIIMA_CHAT_MODEL=deepseek-flash
# Qwen3.7 embeddings use a separate key; the default preset is Model Studio Beijing.
MINIIMA_EMBEDDING_API_KEY=
MINIIMA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINIIMA_EMBEDDING_MODEL=qwen3.7-text-embedding
MINIIMA_EMBEDDING_DIMENSION=1024
MINIIMA_EMBEDDING_BATCH_SIZE=20
MINIIMA_CHUNK_TOKENS=500
MINIIMA_CHUNK_OVERLAP=80
MINIIMA_TIMEOUT=30
MINIIMA_MAX_RETRIES=2
MINIIMA_RETRIEVAL_ENGINE=cpp
